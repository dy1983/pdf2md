# ── LLM 配置 ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 国内中转或 OpenAI-compatible 服务端点，默认为官方
OPENAI_BASE_URL=https://api.openai.com/v1
# 推荐：gpt-4o / gpt-4-turbo / deepseek-chat / qwen-long
LLM_MODEL=gpt-4o

# ── 转换器选择 ─────────────────────────────────────────────────
# marker | magic-pdf
CONVERTER=marker

# ── 校对参数 ───────────────────────────────────────────────────
# 每次发给 LLM 的文本块大小（token 数）
PROOFREAD_CHUNK_TOKENS=1200
# LLM 并发请求数（太大易触发速率限制）
PROOFREAD_CONCURRENCY=3
# LLM 请求失败重试次数
LLM_MAX_RETRIES=3
